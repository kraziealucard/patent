<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane prefHeight="456.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.patent.ZoneViewController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" />
      <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10" vgrow="SOMETIMES" />
        <RowConstraints percentHeight="6.0" vgrow="SOMETIMES" />
    </rowConstraints>

   <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0">
       <contextMenu>
           <ContextMenu fx:id="contextMenu">
               <items>
                   <MenuItem onAction="#updateItems" text="Обновить" />
               </items>
           </ContextMenu>
       </contextMenu>

     <columns>
       <TableColumn fx:id="idClmn" editable="false" minWidth="-1.0" prefWidth="-1.0" text="ID" />
       <TableColumn fx:id="nameClmn" editable="false" minWidth="-1.0" prefWidth="75.0" text="Название" />
         <TableColumn fx:id="forProductClmn" editable="false" minWidth="-1.0" prefWidth="-1.0" text="Для товаров" />
         <TableColumn fx:id="maxWeightClmn" editable="false" prefWidth="-1.0" text="Максимальный вес ячейки" />
         <TableColumn fx:id="numberOfCells" editable="false" minWidth="-1.0" prefWidth="-1.0" text="Кол-во ячеек" />
     </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>

    <HBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
        <Button alignment="BOTTOM_RIGHT" onAction="#toFirst" text="К первому">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
        <Button alignment="BOTTOM_RIGHT" onAction="#toLast" text="К последнему" GridPane.columnIndex="1">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
        <Button alignment="TOP_RIGHT" onAction="#addZone" text="Создать">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
        <Button fx:id="deleteBtn" alignment="BOTTOM_RIGHT" mnemonicParsing="false" onAction="#deleteZones" text="Удалить">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
        <Button alignment="TOP_RIGHT" onAction="#toCell" text="Ячейки" GridPane.columnIndex="2">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
        <Button alignment="TOP_RIGHT" text="Печать">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
      <padding>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding>
    </HBox>



</GridPane>
