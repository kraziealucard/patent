<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" hgap="10" prefHeight="526.0" prefWidth="490.0" vgap="10" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.patent.ProductGroupController">
    <columnConstraints>
        <ColumnConstraints />
      <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>

    <TableView fx:id="productGroupsTable" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Группы товаров" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <HBox alignment="BOTTOM_LEFT" spacing="10" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1">
        <Button text="Перейти к первому" HBox.hgrow="ALWAYS">
         <HBox.margin>
            <Insets bottom="5.0" />
         </HBox.margin></Button>
        <Button text="Перейти к последнему" HBox.hgrow="ALWAYS">
         <HBox.margin>
            <Insets bottom="5.0" />
         </HBox.margin></Button>
    </HBox>

    <Button alignment="BOTTOM_RIGHT" text="Печать" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="1" GridPane.valignment="BOTTOM">
      <GridPane.margin>
         <Insets bottom="5.0" right="5.0" />
      </GridPane.margin></Button>
</GridPane>
