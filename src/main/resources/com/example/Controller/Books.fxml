<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane minHeight="500.0" minWidth="810.0" prefHeight="500.0" prefWidth="1009.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller.BooksController">
   <rowConstraints>
      <RowConstraints vgrow="ALWAYS" />
      <RowConstraints />
   </rowConstraints>
   <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" />
   </columnConstraints>
   <TableView fx:id="table">
      <columns>
         <TableColumn fx:id="IDColumn" prefWidth="75.0" text="Код" />
         <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Дата" />
         <TableColumn fx:id="userColumn" prefWidth="75.0" text="Провел операцию" />
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>
   <HBox alignment="CENTER_LEFT" minHeight="90.0" minWidth="809.0" spacing="5.0" GridPane.rowIndex="1">
      <padding>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding>
      <VBox alignment="CENTER_LEFT" spacing="10.0">
         <RadioButton fx:id="RSupply" mnemonicParsing="false" prefHeight="18.0" prefWidth="141.0" text="Книга поступлений" />
         <RadioButton fx:id="RRepl" mnemonicParsing="false" text="Книга отгрузок" />
         <RadioButton fx:id="RMove" mnemonicParsing="false" text="Книга перемещений" />
      </VBox>
      <Separator orientation="VERTICAL" />
      <HBox alignment="CENTER">
         <children>
            <CheckBox fx:id="typeOfItemCheckBox" mnemonicParsing="false" onAction="#refreshTable" prefHeight="18.0" prefWidth="85.0" text="отобрать:" />
            <ComboBox fx:id="typeOfItemComboBox" onAction="#refreshTable" prefWidth="150.0" />
         </children>
      </HBox>
      <Separator layoutX="161.0" layoutY="15.0" orientation="VERTICAL" />
      <VBox alignment="CENTER" spacing="10.0">
         <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="inCheckBox" minHeight="18.0" minWidth="45.0" mnemonicParsing="false" onAction="#refreshTable" text="c:" />
            <DatePicker fx:id="inDateP" minWidth="0.0" onAction="#refreshTable">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </DatePicker>
         </HBox>
         <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="10.0">
            <CheckBox fx:id="byCheckBox" minHeight="18.0" minWidth="45.0" mnemonicParsing="false" onAction="#refreshTable" text="по:" />
            <DatePicker fx:id="byDateP" onAction="#refreshTable" />
         </HBox>
      </VBox>
      <Separator layoutX="156.0" layoutY="10.0" orientation="VERTICAL" prefHeight="80.0" prefWidth="0.0" />
      <VBox alignment="CENTER" layoutX="172.0" layoutY="15.0" spacing="10.0">
         <HBox alignment="CENTER_LEFT" spacing="5.0">
            <CheckBox fx:id="contactorCheckBox" minWidth="125.0" mnemonicParsing="false" onAction="#refreshTable" text="контрагент:" />
            <ComboBox fx:id="contractComboBox" onAction="#refreshTable" prefWidth="150.0" />
         </HBox>
         <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="10.0" spacing="5.0">
            <CheckBox fx:id="userCheckBox" minHeight="18.0" minWidth="125.0" mnemonicParsing="false" onAction="#refreshTable" text="провел операцию:" />
            <ComboBox fx:id="userComboBox" onAction="#refreshTable" prefWidth="150.0" />
         </HBox>
      </VBox>
      <Separator layoutX="404.0" layoutY="15.0" orientation="VERTICAL" prefHeight="80.0" prefWidth="0.0" />
      <VBox alignment="CENTER_LEFT" spacing="10.0">
         <Button mnemonicParsing="false" onAction="#more" text="Подробнее" />
         <Button layoutX="10.0" layoutY="10.0" minWidth="80.0" mnemonicParsing="false" text="Печать" />
      </VBox>
   </HBox>
</GridPane>
