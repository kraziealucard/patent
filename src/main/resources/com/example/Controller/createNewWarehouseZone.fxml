<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="center" hgap="5" prefHeight="160.0" prefWidth="313.0" vgap="5" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller.createWarehouseZoneController">
   <TextField fx:id="maxWeightField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
   <Label text="Склад для " GridPane.rowIndex="4" />
    <Label text="Имя зоны" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <Label text="Длина" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <Label text="Ширина" GridPane.columnIndex="0" GridPane.rowIndex="2" />

    <TextField fx:id="zoneNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    <TextField fx:id="lengthField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <TextField fx:id="widthField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Button fx:id="btn" onAction="#btnClick" text="Создать" GridPane.rowIndex="5" />
   <ComboBox fx:id="CBoxZoneFor" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
       <items>
           <FXCollections fx:factory="observableArrayList">
               <String fx:value="продуктов" />
               <String fx:value="материалов" />
           </FXCollections>
       </items>
   </ComboBox>
   <Label text="Макс. вес" GridPane.rowIndex="3" />
   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints hgrow="ALWAYS" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
       <RowConstraints />
       <RowConstraints />
   </rowConstraints>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</GridPane>
