<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="rootPane" minHeight="532.0" minWidth="760.0" prefHeight="570.0" prefWidth="1031.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller.movementController">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="553.0" prefWidth="553.6" />
        <ColumnConstraints maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints vgrow="ALWAYS" />
        <RowConstraints />
    </rowConstraints>
    <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="96.0" minWidth="469.0" spacing="5.0" GridPane.hgrow="ALWAYS">
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
        <VBox minHeight="86.4" minWidth="150.0" HBox.hgrow="ALWAYS">
            <Label text="Код">
                <VBox.margin>
                    <Insets left="5.0" />
                </VBox.margin>
            </Label>
            <TextField fx:id="idTextField" editable="false" maxWidth="1.7976931348623157E308" />
            <Label text="Дата">
                <VBox.margin>
                    <Insets left="5.0" />
                </VBox.margin>
            </Label>
            <DatePicker fx:id="datePicker" editable="false" maxWidth="1.7976931348623157E308" minHeight="17.6" minWidth="175.2" />
        </VBox>
        <Separator orientation="VERTICAL" />
        <VBox alignment="CENTER" minHeight="86.0" minWidth="150.0" HBox.hgrow="ALWAYS">
            <Label text="Сотрудник склада">
                <VBox.margin>
                    <Insets left="5.0" />
                </VBox.margin>
            </Label>
            <ComboBox fx:id="performerComboBox" minWidth="117.6">
                <VBox.margin>
                    <Insets />
                </VBox.margin>
            </ComboBox>
        </VBox>
        <Separator orientation="VERTICAL" />
        <VBox alignment="CENTER" minHeight="86.4" minWidth="150.0" HBox.hgrow="ALWAYS">
            <Label text="№ накладной">
                <VBox.margin>
                    <Insets left="5.0" />
                </VBox.margin>
            </Label>
            <TextField fx:id="invoiceNumberTextField" maxWidth="1.7976931348623157E308" />
        </VBox>
    </HBox>
    <TableView fx:id="table" editable="true" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="ItemColumn" onEditCommit="#commitEditItem" text="Товар" />
         <TableColumn fx:id="weightItemColumn" prefWidth="75.0" text="Вес товара" />
            <TableColumn fx:id="fromColumn" prefWidth="75.0" text="Исходник" />
            <TableColumn fx:id="amountOnCellColumn" editable="false" prefWidth="75.0" text="Кол-во в ячеке" />
            <TableColumn fx:id="amountColumn" onEditCommit="#commitEditAmount" prefWidth="75.0" text="Кол-во к отправке" />
         <TableColumn fx:id="availableAmountColumn" prefWidth="75.0" text="Остаток" />
         <TableColumn fx:id="sumWeightColumn" prefWidth="75.0" text="Сумма веса" />
         <TableColumn fx:id="whereColumn" onEditCommit="#commitWhereEdit" prefWidth="75.0" text="Назначение" />
         <TableColumn fx:id="availableWeightColumn" prefWidth="75.0" text="Доступный вес" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
    <HBox alignment="BOTTOM_LEFT" spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
        <Button fx:id="addButton" mnemonicParsing="false" onAction="#addItem" text="Добавить">
            <HBox.margin>
                <Insets />
            </HBox.margin>
        </Button>
        <Button fx:id="removeButton" mnemonicParsing="false" onAction="#removeItem" text="Удалить">
            <HBox.margin>
                <Insets />
            </HBox.margin>
        </Button>
        <Button fx:id="finishButton" mnemonicParsing="false" onAction="#finish" text="Провести">
            <HBox.margin>
                <Insets right="5.0" />
            </HBox.margin>
        </Button>
      <Button mnemonicParsing="false" onAction="#toExcel" text="Печать" />
    </HBox>
</GridPane>
