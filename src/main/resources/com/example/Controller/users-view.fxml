<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.example.Controller.UsersViewController">
    <minHeight>200</minHeight>
    <minWidth>200</minWidth>
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0"/>
        <ColumnConstraints/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="8.0"/>
        <RowConstraints percentHeight="84" vgrow="ALWAYS"/>
        <RowConstraints percentHeight="8.0"/>
    </rowConstraints>
    <HBox>
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </padding>
        <children>
            <Label text="Пользователи">
                <font>
                    <Font size="19.0"/>
                </font>
            </Label>
            <TextField fx:id="searchTF" onAction="#toSearch" promptText="Поиск..." HBox.hgrow="ALWAYS">
                <HBox.margin>
                    <Insets left="5.0" top="2.0"/>
                </HBox.margin>
            </TextField>
        </children>
    </HBox>

    <TableView fx:id="userTable" editable="true" GridPane.columnIndex="0" GridPane.columnSpan="2"
               GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" editable="false" minWidth="-1.0" prefWidth="-1.0" text="Код"/>
            <TableColumn fx:id="nameColumn" minWidth="-1.0" prefWidth="-1.0" text="Имя"/>
            <TableColumn fx:id="positionColumn" minWidth="-1.0" prefWidth="-1.0" text="Должность"/>
            <TableColumn fx:id="loginColumn" minWidth="-1.0" prefWidth="-1.0" text="Логин"/>
            <TableColumn fx:id="passwordColumn" minWidth="-1.0" prefWidth="-1.0" text="Пароль"/>
            <TableColumn fx:id="activeColumn" prefWidth="75.0" text="Активен"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2"
          GridPane.vgrow="ALWAYS">
        <Button onAction="#toFirst" text="К первому" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets/>
            </HBox.margin>
        </Button>
        <Button onAction="#toLast" text="К последнему" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets/>
            </HBox.margin>
        </Button>
        <Button mnemonicParsing="false" onAction="#addUser" text="Добавить" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets/>
            </HBox.margin>
        </Button>
        <CheckBox fx:id="CheckBoxFilter" mnemonicParsing="false" onAction="#toFilter" text="Отобрать по должности: "
                  HBox.hgrow="ALWAYS">
            <opaqueInsets>
                <Insets/>
            </opaqueInsets>
            <HBox.margin>
                <Insets bottom="5.0"/>
            </HBox.margin>
        </CheckBox>
        <ComboBox fx:id="ComboBoxFilter" onAction="#toFilter" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets/>
            </HBox.margin>
        </ComboBox>
        <Button onAction="#toExcel" text="Печать" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets/>
            </HBox.margin>
        </Button>
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0"/>
        </padding>
    </HBox>


    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>

</GridPane>
