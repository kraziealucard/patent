<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane minHeight="435.0" minWidth="677.0" prefHeight="435.0" prefWidth="866.0"
          xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.example.Controller.ProductListController">
    <TreeView fx:id="ListGroup"/>
    <TableView fx:id="table" editable="true" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0"
               GridPane.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" editable="false" prefWidth="75.0" text="ID"/>
            <TableColumn fx:id="nameColumn" onEditCancel="#cancelEditName" onEditCommit="#commitEditName"
                         prefWidth="150.0" text="Название"/>
            <TableColumn fx:id="weightColumn" onEditCancel="#cancelEditWeight" onEditCommit="#commitEditWeight"
                         prefWidth="150.0" text="Вес"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
        <children>
            <Button mnemonicParsing="false" onAction="#toFirst" text="К первому"/>
            <Button mnemonicParsing="false" onAction="#toLast" text="К последнему"/>
            <Button mnemonicParsing="false" onAction="#addProduct" text="Добавить"/>
            <Button fx:id="removeButton" mnemonicParsing="false" onAction="#removeProduct" text="Удалить"/>
            <Button fx:id="saveToExcelButton" mnemonicParsing="false" onAction="#toExcel" text="Печать"/>
            <Button mnemonicParsing="false" onAction="#TypeSetGroup" text="Перенести в"/>
            <ComboBox fx:id="groupComboBox" prefWidth="150.0"/>
            <Button fx:id="explainButton" mnemonicParsing="false" onAction="#toExplain" text="Провести"/>
        </children>
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </padding>
    </HBox>
    <columnConstraints>
        <ColumnConstraints maxWidth="643.8" minWidth="150.6" prefWidth="165.2"/>
        <ColumnConstraints maxWidth="998.199984741211" minWidth="532.2" prefWidth="701.2"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints/>
        <RowConstraints/>
    </rowConstraints>
</GridPane>
